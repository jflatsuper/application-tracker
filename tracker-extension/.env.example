# Read when the extension is BUILT (npm run build), then baked in.
#
# The Refresha API, including the /api prefix (same value as the web app's
# VITE_API_BASE_URL). The build also grants the extension access to this origin.
VITE_API_BASE_URL=http://localhost:8000/api

# Where the web app is served. Used for "Open in Refresha" and the upgrade link.
VITE_APP_URL=http://localhost:5173

# Optional. Pins the extension's ID so it is the same on every machine (it
# otherwise depends on the folder you load it from). This is a PUBLIC key, safe
# to commit. The ID it gives, for the web app's VITE_EXTENSION_ID, is:
#   doanhgclbjgfkinmplmkiakhalmmbfll
# Leave it unset when building for the Chrome Web Store, which assigns its own.
VITE_EXTENSION_
