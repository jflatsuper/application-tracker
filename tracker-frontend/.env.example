# Base URL of the Refresha API, including the /api prefix. Vite reads this at
# BUILD time, so set it wherever the build runs (your shell, or the Cloudflare
# dashboard's build variables), not on the deployed site.
#
# Local:       http://localhost:8000/api
# Production:  https://api.your-domain.com/api
#
# The app and the API must share a parent domain (app.example.com and
# api.example.com) or the sign-in cookie will not be sent. Local development
# must use the same host name for both (localhost or 127.0.0.1).
VITE_API_BASE_URL=http://localhost:8000/api

# Optional. Where people can reach you. When set, a Contact page and footer
# link appear and the privacy policy names it. Left empty, they're left out.
VITE_SUPPORT_EMAIL=

# Optional but recommended for production: the address the site is served from,
# without a trailing slash. It turns on canonical links, the sitemap, the
# robots.txt Sitemap line and the social-preview image, all of which need an
# absolute address. Set it where the build runs, like VITE_API_BASE_URL.
VITE_SITE_URL=

# Optional. The Google tag ID from Google Analytics (looks like G-XXXXXXXXXX).
# When set, a cookie banner asks visitors first; once they accept, the tag
# loads and each route change is sent as a page
# view (the path only, never the query string or the #token fragment). Left
# empty, nothing from Google is loaded and the privacy policy says so. Set it
# where the build runs, like VITE_API_BASE_URL.
VITE_GOOGLE_TAG_ID=
