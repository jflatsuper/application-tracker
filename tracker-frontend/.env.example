# Base URL of the Refresha API, including the /api prefix. Vite reads this at
# BUILD time, so set it wherever the build runs (your shell, or the Cloudflare
# dashboard's build variables), not on the deployed site.
#
# Local:       http://localhost:8000/api
# Production:  https://api.your-domain.com/api
#
# The app and the API must share a parent domain (app.example.com and
# api.example.com) or the sign-in cookie will not be sent. Local development
# must use the same host name for both (localhost or 127.0.0.1).
VITE_API_BASE_URL=http://localhost:8000/api
